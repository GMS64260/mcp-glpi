{
  "name": "mcp-glpi",
  "version": "4.1.0",
  "description": "MCP Server for GLPI - IT Service Management for Claude. Multi-criteria search, pagination, dynamic field resolution, ticket timeline, ITIL coverage (incidents, problems, changes, validations), asset CMDB, reporting.",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mcp-glpi": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "measure": "tsx scripts/measure-catalogue.ts",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "glpi",
    "itsm",
    "itil",
    "helpdesk",
    "service-desk",
    "tickets",
    "incidents",
    "problems",
    "changes",
    "assets",
    "inventory",
    "cmdb",
    "knowledge-base",
    "contracts",
    "projects",
    "claude",
    "anthropic",
    "ai",
    "llm",
    "automation"
  ],
  "author": "GMS64260",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMS64260/mcp-glpi.git"
  },
  "bugs": {
    "url": "https://github.com/GMS64260/mcp-glpi/issues"
  },
  "homepage": "https://github.com/GMS64260/mcp-glpi#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.5",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
